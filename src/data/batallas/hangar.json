    "inicio": [
      {
        "quien": "Voz",
        "texto": "Alarma del hangar: activa. Acceso no autorizado a recurso decorativo."
      },
      {
        "quien": "Cami",
        "texto": "Te dije que no tocaras nada. …No te lo dije. Pero era obvio."
      }
    ],
    "refuerzos": [
      {
        "quien": "Voz",
        "texto": "Otro soldado entra por la puerta del fondo. Idéntico. Siempre idéntico."
      }
    ],
    "jefe": [
      {
        "quien": "Voz",
        "texto": "Pasos más pesados. Una armadura gris con bordes de cobre y un visor rojo en forma de V."
      },
      {
        "quien": "Capitán de la Federación",
        "texto": "Guerrera. Te dimos por muerta. Y traes compañía."
      },
      {
        "quien": "Cami",
        "texto": "Me acuerdo de ti. Eras el capitán que gritaba mucho."
      }
    ],
    "jefe_huye": [
      {
        "quien": "Voz",
        "texto": "El capitán retrocede entre las naves, sin dejar de apuntar. El blaster le sigue brillando."
      }
    ],
    "victoria": [
      {
        "quien": "Jair",
        "texto": "(Retrocede. No se va. Hay una diferencia, y la conozco.)"
      }
    ],
    "derrota": [
      {
        "quien": "Capitán de la Federación",
        "texto": "Entidad no registrada. Procedimiento: archivar. Con la guerrera."
      }
    ],
    "huir_no": [
      {
        "quien": "Cami",
        "texto": "¿Huir? ¿Por dónde? Encendiste el hangar entero."
      }
    ],
    "huir": [
      {
        "quien": "Voz",
        "texto": "Escapan por un pasillo lateral."
      }
    ],
    "descanso": [
      {
        "quien": "Cami",
        "texto": "Dame un segundo… El tobillo."
      }
    ],
    "cae_jair": [
      {
        "quien": "Cami",
        "texto": "¿Jair? ¡Jair! ¿Me vas a dejar sola con el capitán? Típico."
