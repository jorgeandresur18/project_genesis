    "inicio": [
      {
        "quien": "Voz",
        "texto": "Demo de batalla: Jair, Cami y Rikka contra la horda del Bastión. Aquí sí se puede huir."
      }
    ],
    "refuerzos": [
      {
        "quien": "Voz",
        "texto": "El soldado pide refuerzos por radio antes de caer. Llega otro, idéntico."
      }
    ],
    "jefe": [
      {
        "quien": "Jair",
        "texto": "(Ese ruido. Un módem conectándose. Lo conozco del trabajo.)"
      },
      {
        "quien": "Cami",
        "texto": "Es el de antes. El de la tinta. ¡No dejes que te toque!"
      }
    ],
    "jefe_huye": [
      {
        "quien": "Voz",
        "texto": "El monstruo se hunde en su sombra. El vórtice retrocede hasta perderse al fondo del pasillo. No se fue: solo dejó de estar a la vista."
      }
    ],
    "victoria": [
      {
        "quien": "Voz",
        "texto": "Entidad hostil: fuera de rango visual."
      },
      {
        "quien": "Jair",
        "texto": "(No se fue. Solo dejó de estar a la vista. Conozco la diferencia.)"
      }
    ],
    "derrota": [
      {
        "quien": "Soldado",
        "texto": "Entidad no registrada. Procedimiento: archivar."
      }
    ],
    "huir_no": [
