{
  "name": "proyecto-genesis",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:routes": "vitest run tests/routes.test.ts",
    "e2e": "playwright test",
    "guion:exportar": "node tools/guion.mjs exportar",
    "guion:importar": "node tools/guion.mjs importar",
    "sprites": "node --max-old-space-size=12000 tools/sprites.mjs && python -I tools/igualar_piel.py",
    "fondos": "node tools/fondos.mjs",
    "og": "node tools/og.mjs",
    "compartir": "node tools/compartir.mjs",
    "nivel:sprites": "node tools/nivel_sprites.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "ag-psd": "^22.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "sharp": "^0.33.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
